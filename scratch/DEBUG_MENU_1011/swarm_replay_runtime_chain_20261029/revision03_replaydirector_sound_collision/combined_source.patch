+    Camera::CollisionPolicySharedInfo lPolicyInfo;
+    FillInSharedInfo(&lInfo, &lPolicyInfo, lpFrame, lpIO);
+    Camera::CollisionPolicy* lpPolicy = mExternalBehaviour.GetCollisionPolicy();

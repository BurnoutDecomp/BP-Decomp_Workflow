IDA Files/*.id0
IDA Files/*.id1
IDA Files/*.id2
IDA Files/*.nam
IDA Files/*.til
IDA Files/*.dmp

# --- Bulk extracted reference source (too many files) ---
references/Feb-2007/BrnEntityModuleUnity/*
references/Apt/*
!references/Apt/README.md

# --- Ledger (local working store, rebuildable via `work seed --deps`) ---
progress/ledger.sqlite
progress/ledger.sqlite-wal
progress/ledger.sqlite-shm

# --- Generated reconstruction skeletons (regenerate from tu_index.json) ---
progress/skeletons/*

# --- Generated reviewer packets (regenerated by `work submit`) ---
progress/reviews/*

# --- Generated trap stubs (regenerated by `work stubs`) ---
progress/stubs/*

# --- Python ---
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.mypy_cache/
.pytest_cache/

# --- Tool run logs ---
tools/*.log

# --- Local coordination config (copy from .env.example) ---
.env

# --- Local build config (copy from build.config.example.toml) ---
build.config.toml

# --- Editor / OS cruft ---
.vscode/*
.idea/
*.swp
Thumbs.db
Desktop.ini
.DS_Store

# Xenia execution traces (binary, large; goals.json holds the derived TU list)
.trace/

references/private


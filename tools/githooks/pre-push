#!/bin/sh
# Opt-in cached XDK and ledger checks for the byte-match workflow.
[ "${BP_BYTE_MATCH_HOOKS:-}" = 1 ] || exit 0
hook_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd) || exit 1
root=$(git rev-parse --show-toplevel) || exit 1
if command -v python >/dev/null 2>&1; then
    exec python "$hook_dir/../hooks/match_guard.py" "$root"
fi
exec python3 "$hook_dir/../hooks/match_guard.py" "$root"

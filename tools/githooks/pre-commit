#!/bin/sh
# Parent-repo pre-commit guard. Installed by `work hooks install`
# (git config core.hooksPath tools/githooks); `work hooks status` shows whether it is on.
#
# 1. The reconcile bot commits progress/status.json, the audit outputs and the b5-decomp
#    pointer after every b5-decomp push. Committing them by hand races the bot and hands
#    everyone a conflicting pull (AGENTS.md, "Don't"), so they are refused: a `git add -A`
#    or `git commit -a` cannot sweep them into your change.
#    Override for one deliberate maintainer commit:  BP_ALLOW_BOT_FILES=1 git commit ...
# 2. If this clone has an untracked `.git/info/public-denylist` (one regex per line, `#`
#    comments), staged added lines must match none of it: terms the maintainer keeps out of
#    the public repository without naming them in a tracked file. The commit-msg hook
#    applies the same list to the message.  Override:  BP_ALLOW_DENYLIST=1 git commit ...

# Merges, cherry-picks, reverts and rebases replay commits that already exist; the bot's
# files and existing text arrive in them legitimately.
for state in MERGE_HEAD CHERRY_PICK_HEAD REVERT_HEAD; do
  git rev-parse -q --verify "$state" >/dev/null 2>&1 && exit 0
done
for dir in rebase-merge rebase-apply; do
  [ -d "$(git rev-parse --git-path "$dir")" ] && exit 0
done

status=0

if [ "${BP_ALLOW_BOT_FILES:-}" != "1" ]; then
  bot_owned="progress/status.json progress/class_homes.json progress/funcaudit.json progress/stubs.json progress/source_status.json progress/asmaudit.json progress/linked_files.json progress/bytematch.json progress/BYTEMATCH.md b5-decomp"
  hits=""
  for path in $bot_owned; do
    if ! git diff --cached --quiet -- "$path" 2>/dev/null; then
      hits="$hits $path"
    fi
  done
  if [ -n "$hits" ]; then
    echo "pre-commit: refusing to commit files the reconcile bot owns:" >&2
    for path in $hits; do
      echo "  $path" >&2
    done
    echo "Unstage them and commit only your own paths:  git restore --staged -- <path>" >&2
    echo "Maintainer override for one commit: BP_ALLOW_BOT_FILES=1 git commit ..." >&2
    status=1
  fi
fi

deny="$(git rev-parse --git-common-dir)/info/public-denylist"
if [ "${BP_ALLOW_DENYLIST:-}" != "1" ] && [ -f "$deny" ]; then
  patterns=$(mktemp) || exit 1
  grep -v -E '^[[:space:]]*(#|$)' "$deny" > "$patterns"
  if [ -s "$patterns" ]; then
    found=$(git diff --cached -U0 --no-color | grep -E '^\+' | grep -v -E '^\+\+\+ ' | grep -i -E -f "$patterns" | cut -c1-160)
    if [ -n "$found" ]; then
      echo "pre-commit: staged lines match this clone's public-denylist:" >&2
      echo "$found" | sed 's/^/  /' >&2
      echo "Reword them. Override for one deliberate commit: BP_ALLOW_DENYLIST=1 git commit ..." >&2
      status=1
    fi
  fi
  rm -f "$patterns"
fi

exit $status

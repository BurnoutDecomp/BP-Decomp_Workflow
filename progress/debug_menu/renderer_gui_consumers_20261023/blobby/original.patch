+// argument only, so later debug edits do not replace it.
+void BrnBlobbyShadowManager::Render(Matrix44 lViewProjection,
+                                   CgsGraphics::Im3d* lpIm3d,
+                                   renderengine::Texture* lpBlobbyShadowTexture,
+                                   f32 lfAlpha,

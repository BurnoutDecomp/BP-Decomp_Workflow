+            lShadow.mvAt.y * lShadow.mvFront_Rear_BackAxle_FrontAxle.x,
+            lShadow.mvAt.z * lShadow.mvFront_Rear_BackAxle_FrontAxle.x,
+            lShadow.mvAt.w * lShadow.mvFront_Rear_BackAxle_FrontAxle.x,

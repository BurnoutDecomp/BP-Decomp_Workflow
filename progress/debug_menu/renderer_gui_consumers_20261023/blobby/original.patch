+            lShadow.mvAt.y * lShadow.mvFront_Rear_BackAxle_FrontAxle.w + lShadow.mvPos.y,
+            lShadow.mvAt.z * lShadow.mvFront_Rear_BackAxle_FrontAxle.w + lShadow.mvPos.z,

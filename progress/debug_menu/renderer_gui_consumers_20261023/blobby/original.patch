+        {0.0f, 0.1875f}, {1.0f, 0.1875f},
+        {0.0f, 0.8125f}, {1.0f, 0.8125f},
+        {0.0f, 1.0f}, {1.0f, 1.0f},
+    };
+
+    lpIm3d->BeginRendering();
+    lpIm3d->SetTransform(lViewProjection);

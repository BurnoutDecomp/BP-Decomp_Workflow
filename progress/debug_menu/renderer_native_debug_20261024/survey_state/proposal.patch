+    // FLAG PC-platform leaf: ARTIST82949E90 maps survey Flags bit0 to
+    // PA_SC_VIZ_QUERY.kill_pix_post_hi_z. D3D9 queries have no matching mode.
+    // Keep the actual GPU box draw and its tests while preventing its post-test
+    // outputs. The native alpha-coverage reconciler remains the sole hook owner.
+    class OcclusionSurveyPixelWritesPC
+    {
+        IDirect3DDevice9* mpDevice = nullptr;
+        OcclusionSurveySubmissionTokenPC muSerial = 0;
+        u32 muFlags = 0;
+        DWORD mauSaved[10] = {};
+        bool mbSavedCoverageRequest = false;
+        bool mbSavedCoverageApplied = false;
+        bool mbArmed = false;
+
+        static constexpr D3DRENDERSTATETYPE kaeStates[10] = {
+            D3DRS_COLORWRITEENABLE, D3DRS_COLORWRITEENABLE1,
+            D3DRS_COLORWRITEENABLE2, D3DRS_COLORWRITEENABLE3,
+            D3DRS_ZWRITEENABLE, D3DRS_STENCILWRITEMASK, D3DRS_ALPHATESTENABLE,
+            D3DRS_ZENABLE, D3DRS_ZFUNC, D3DRS_CULLMODE
+        };
+
+        bool Read(DWORD (&lauValues)[10], u32 luCount = 10u) const
+        {
+            bool lbValid = true;
+            for (u32 lu = 0; lu < luCount; ++lu)
+                lbValid = SUCCEEDED(mpDevice->GetRenderState(kaeStates[lu], &lauValues[lu])) && lbValid;
+            return lbValid;
+        }
+
+        static u32& TraceCount()
+        {
+            static u32 suLines = 0;
+            return suLines;
+        }
+
+        static bool TraceActive()
+        {
+            static const bool sbEnabled = []() {
+                const char* lpcValue = std::getenv("BRN_OCCLUSION_DIAG");
+                return lpcValue && lpcValue[0] == '1' && lpcValue[1] == '\0';
+            }();
+            return sbEnabled && TraceCount() < 96u;
+        }
+
+        void Trace(const char* lpcStage, bool lbRead, const DWORD (&lauValues)[10], bool lbRestored) const
+        {
+            if (!TraceActive())
+                return;
+            char lacLine[384];
+            std::snprintf(lacLine, sizeof(lacLine),
+                "[occ-draw-state] stage=%s serial=%llu flags=%u read=%u cw=%u,%u,%u,%u zw=%u sw=%u at=%u ze=%u zf=%u cull=%u a2req=%u a2applied=%u restored=%u\n",
+                lpcStage, static_cast<unsigned long long>(muSerial), muFlags, lbRead ? 1u : 0u,
+                static_cast<unsigned>(lauValues[0]), static_cast<unsigned>(lauValues[1]),
+                static_cast<unsigned>(lauValues[2]), static_cast<unsigned>(lauValues[3]),
+                static_cast<unsigned>(lauValues[4]), static_cast<unsigned>(lauValues[5]),
+                static_cast<unsigned>(lauValues[6]), static_cast<unsigned>(lauValues[7]),
+                static_cast<unsigned>(lauValues[8]), static_cast<unsigned>(lauValues[9]),
+                sbA2cRequested ? 1u : 0u, sbA2cApplied ? 1u : 0u, lbRestored ? 1u : 0u);
+            CgsDev::Log::WriteToLog(lacLine);
+            ++TraceCount();
+        }
+
+    public:
+        OcclusionSurveyPixelWritesPC(IDirect3DDevice9* lpDevice, OcclusionSurveySubmissionTokenPC luSerial)
+            : mpDevice(lpDevice), muSerial(luSerial), muFlags(OcclusionQueryProviderPCGetSurveyFlags())
+        {
+            if ((muFlags & 1u) == 0u)
+                return;
+            const bool lbRead = Read(mauSaved, TraceActive() ? 10u : 7u);
+            CGS_ASSERT(lbRead, "could not capture native survey render states");
+            if (!lbRead)
+                return;
+            mbSavedCoverageRequest = sbA2cRequested;
+            mbSavedCoverageApplied = sbA2cApplied;
+            Trace("before", true, mauSaved, false);
+            mbArmed = true;
+            bool lbSet = true;
+            // Four color masks, depth write, stencil write and alpha test.
+            // Depth/stencil tests, comparison function and culling remain intact.
+            for (u32 lu = 0; lu < 7u; ++lu)
+                lbSet = SUCCEEDED(mpDevice->SetRenderState(kaeStates[lu], 0u)) && lbSet;
+            sbA2cRequested = false;
+            AlphaCoverage_Reconcile();
+            CGS_ASSERT(lbSet, "could not suppress native survey pixel writes");
+            if (TraceActive())
+            {
+                DWORD lauActual[10] = {};
+                const bool lbActual = Read(lauActual);
+                Trace("draw", lbActual, lauActual, false);
+            }
+        }
+
+        OcclusionSurveyPixelWritesPC(const OcclusionSurveyPixelWritesPC&) = delete;
+        OcclusionSurveyPixelWritesPC& operator=(const OcclusionSurveyPixelWritesPC&) = delete;
+
+        ~OcclusionSurveyPixelWritesPC()
+        {
+            if (!mbArmed)
+                return;
+            bool lbSet = true;
+            for (u32 lu = 0; lu < 7u; ++lu)
+                lbSet = SUCCEEDED(mpDevice->SetRenderState(kaeStates[lu], mauSaved[lu])) && lbSet;
+            sbA2cRequested = mbSavedCoverageRequest;
+            AlphaCoverage_Reconcile();
+            CGS_ASSERT(lbSet, "could not restore native survey render states");
+            if (TraceActive())
+            {
+                DWORD lauActual[10] = {};
+                const bool lbRead = Read(lauActual);
+                const bool lbRestored = lbRead && std::memcmp(lauActual, mauSaved, sizeof(mauSaved)) == 0
+                    && sbA2cRequested == mbSavedCoverageRequest && sbA2cApplied == mbSavedCoverageApplied;
+                Trace("restored", lbRead, lauActual, lbRestored);
+            }
+        }
+    };
